# Optional. With no key, Relay uses its built-in offline writer, so the demo always works.
ANTHROPIC_API_KEY=
# "claude" or "offline". Defaults to claude when a key is set, offline otherwise.
RELAY_LLM_PROVIDER=

# Database. Leave empty locally to use embedded Postgres in .data/pglite (zero setup).
# On Vercel, set DATABASE_URL (or POSTGRES_URL from the Neon integration) so data survives
# redeploys. Without it the app shows a warning and keeps demo data in memory only.
DATABASE_URL=

# Demo clock. The seeded story happens on Dec 6, 2026. Set to "off" to use the real time.
RELAY_DEMO_NOW=2026-12-06T09:00:00Z

# Optional: post deliveries to a Slack incoming webhook as well as the in-app inbox.
# Replaced by the Slack app (T-40): SLACK_CLIENT_ID, SLACK_CLIENT_SECRET, SLACK_SIGNING_SECRET.
SLACK_WEBHOOK_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Encrypts stored Slack/GitHub install tokens (T-40, T-44). Fall back: AUTH_SECRET (dev only).
ENCRYPTION_KEY=

# Legacy per-repo webhook secret (still accepted). Prefer the GitHub App secrets below (T-44).
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# App → Credentials: Client ID + Client secret (needed for user OAuth during installation).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional slug for the "Install on GitHub" link: https://github.com/apps/<slug>/installations/new
GITHUB_APP_SLUG=


# Optional. "on" turns back on agents that do work (research, document review, code, drafting),
# the agent gallery, the leadership digest and the team map. Off by default: the product spec
# defers them until answers and routing are trusted.
BEACON_WORKERS=

# Sign-in (T-31). AUTH_SECRET is required in production. Google/Microsoft need OAuth client
# credentials; EMAIL_SERVER is an HTTPS webhook that receives { to, subject, text } for magic links.
# Without these, sample workspaces still open from /signin.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app registration: under Token configuration → Add optional claim → ID, add
# `email` and `xms_edov`. Without `xms_edov`, new Microsoft sign-ins are treated as unverified
# and cannot create or link accounts by email (T-36).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
EMAIL_SERVER=
NEXT_PUBLIC_SITE_URL=
# Comma-separated emails that can sign in without approval and manage /admin/early-access (T-36).
BEACON_ADMIN_EMAILS=
