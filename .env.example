# Optional. With no key, Relay uses its built-in offline writer, so the demo always works.
ANTHROPIC_API_KEY=
# "claude" or "offline". Defaults to claude when a key is set, offline otherwise.
RELAY_LLM_PROVIDER=

# Database. Leave empty to use the embedded Postgres in .data/pglite (zero setup).
# Set to a Postgres URL (Neon, Supabase, RDS) when hosting.
DATABASE_URL=

# Demo clock. The seeded story happens on Dec 6, 2026. Set to "off" to use the real time.
RELAY_DEMO_NOW=2026-12-06T09:00:00Z

# Optional: post deliveries to a Slack incoming webhook as well as the in-app inbox.
SLACK_WEBHOOK_URL=
# Optional: verify GitHub webhook signatures.
GITHUB_WEBHOOK_SECRET=

# Optional. "on" turns back on agents that do work (research, document review, code, drafting),
# the agent gallery, the leadership digest and the team map. Off by default: the product spec
# defers them until answers and routing are trusted.
BEACON_WORKERS=
